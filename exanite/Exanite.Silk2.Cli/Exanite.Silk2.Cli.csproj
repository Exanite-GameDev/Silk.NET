<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <ExaniteEngineBuildSystem>false</ExaniteEngineBuildSystem>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build" Version="18.9.6" PrivateAssets="all" ExcludeAssets="runtime"/>
    <PackageReference Include="Microsoft.Build.Framework" Version="18.9.6" PrivateAssets="all" ExcludeAssets="runtime"/>
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.9.6" PrivateAssets="all" ExcludeAssets="runtime"/>
    <PackageReference Include="Microsoft.NET.StringTools" Version="18.9.6" PrivateAssets="all" ExcludeAssets="runtime"/>
    <PackageReference Include="NuGet.Frameworks" Version="7.9.0" PrivateAssets="all" ExcludeAssets="runtime"/>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Exanite.Engine" Version="0.0.0-preview-dev-ui.6701"/>
    <PackageReference Include="Exanite.Engine.BuildSystem" Version="0.0.0-preview-dev-ui.6701"/>
  </ItemGroup>
</Project>
